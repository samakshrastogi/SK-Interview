NODE_ENV=development
PORT=4003

# Databases
MONGO_URI=mongodb://localhost:27017/sk_careerhub
REDIS_URI=redis://localhost:6379

# JWT Configuration
JWT_ACCESS_SECRET=your_jwt_access_secret
JWT_REFRESH_SECRET=your_jwt_refresh_secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# SMTP / Email Configuration (GoDaddy SecureServer Details)
MAIL_FROM=SK Quiz Coach <hello@sk-hub.in>
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=hello@sk-hub.in
SMTP_PASS=your_smtp_password_here

# Frontend Client URL
CLIENT_URL=http://localhost:5476
