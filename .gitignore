# Dependency directories
node_modules/
**/node_modules/

# TypeScript build files
*.tsbuildinfo
**/*.tsbuildinfo

# Compiled JavaScript in source folders (TSC in-place compilation)
**/src/**/*.js
**/src/**/*.js.map
**/src/**/*.d.ts
**/src/**/*.d.ts.map

# Production builds
dist/
**/dist/
build/
.svelte-kit/
.next/
out/

# Local environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
logs/
*.log

# Editor & OS settings
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# Diagnostic / Coverage
coverage/
